DATABASE_URL=postgres://openrms:openrms@127.0.0.1:5442/openrms_accounts
PORT=8789
# Listen on loopback only (default); a reverse proxy or tunnel serves the public URL.
HOST=127.0.0.1
# Client-IP header set by your proxy, for per-IP rate limits. Only if Accounts is reachable
# solely through that proxy. Behind Cloudflare Tunnel: cf-connecting-ip. Empty: Better Auth default.
TRUSTED_IP_HEADERS=
TRUSTED_PROXIES=
# Public origin; also the OIDC issuer. Production: https://auth.openrms.dev
BETTER_AUTH_URL=http://localhost:8789
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production: .openrms.dev (shared session cookie for first-party apps). Leave unset in dev.
COOKIE_DOMAIN=
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Where sign-in, consent and the device-link page live (the Site during AC1)
UI_URL=http://localhost:5173
# Your deployment's API origins (Atlas, Rigs, ...), comma-separated
FIRST_PARTY_AUDIENCES=http://localhost:8787,http://localhost:8790
RESOURCES=http://localhost:8787,http://localhost:8790
REQUIRE_EMAIL_VERIFICATION=false
# Staff need TOTP or a passkey (spec §4b). Turn on once every staff account has enrolled.
STAFF_2FA_REQUIRED=false
# Unset: mail is logged. Cloudflare Email Sending: smtps://api_token:<token>@smtp.mx.cloudflare.net:465
SMTP_URL=
MAIL_FROM=openRMS <noreply@localhost>
